#!/usr/bin/env node
// herd-trail CLI — 唯一事实源。见 docs/prd.md §3/§4(T1/T2/T6/T7)。
"use strict";

const path = require("node:path");
const store = require("../src/store.js");
const todos = require("../src/todos.js");
const { captureSource } = require("../src/provenance.js");

const usage = `herd-trail — herd 全局共享 todolist(见 docs/prd.md)

用法:
  herd-trail add "文本"           记录(溯源自动捕获)
  herd-trail list [--all] [--json] [--agent X] [--project Y]   列出(open 优先)
  herd-trail show <id> [--json]   详情(含溯源)
  herd-trail edit <id> "新文本"  改文本(保留状态/溯源)
  herd-trail done|undo|rm <id>    完成/撤销/删除(id 可用唯一前缀)
  herd-trail open <id>            跳回源对话(focus 或 resume)
  herd-trail path                 打印数据文件路径
`;

function fail(msg, code = 1) {
  process.stderr.write("herd-trail: " + msg + "\n");
  process.exit(code);
}

const { ageLabel } = require("../src/overlay-view.js");

function file() {
  return store.storeFile(store.resolveStoreDir());
}

function parseFlags(args, withValue = []) {
  const flags = {};
  const rest = [];
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a.startsWith("--")) {
      const k = a.slice(2);
      if (withValue.includes(k)) flags[k] = args[++i];
      else flags[k] = true;
    } else rest.push(a);
  }
  return { flags, rest };
}

function line(t) {
  const agent = t.source?.agent_name || "-";
  const project = todos.projectOf(t) || "-";
  const when = t.status === "done" && t.done_at ? t.done_at : t.created_at;
  return [t.id, t.status, ageLabel(when), agent, project, t.text].join("  ");
}

function cmdAdd(args) {
  const text = args.join(" ");
  const source = captureSource();
  let todo;
  try {
    todo = todos.addTodo(file(), text, source);
  } catch (e) {
    fail(e.message, /empty/.test(e.message) ? 2 : 1);
  }
  console.log(todo.id + "  " + todo.text);
}

function cmdList(args) {
  const { flags } = parseFlags(args, ["agent", "project"]);
  const rows = todos.listTodos(store.readStore(file()), {
    all: !!flags.all,
    agent: flags.agent ?? null,
    project: flags.project ?? null,
  });
  if (flags.json) {
    console.log(JSON.stringify(rows, null, 2));
    return;
  }
  if (!rows.length) {
    console.log("(empty)");
    return;
  }
  for (const t of rows) console.log(line(t));
}

function cmdShow(args) {
  const { flags, rest } = parseFlags(args);
  const id = rest[0];
  if (!id) fail("show 需要 <id>", 2);
  let t;
  try {
    t = todos.findTodo(store.readStore(file()), id);
  } catch (e) {
    fail(e.message);
  }
  if (flags.json) {
    console.log(JSON.stringify(t, null, 2));
    return;
  }
  const s = t.source ?? {};
  console.log("id: " + t.id);
  console.log("text: " + t.text);
  console.log("status: " + t.status);
  console.log("created_at: " + t.created_at);
  console.log("done_at: " + (t.done_at ?? "null"));
  console.log("updated_at: " + (t.updated_at ?? "null"));
  console.log("source:");
  for (const k of ["kind", "agent_name", "pane_id", "workspace_id", "tab_id", "cwd", "pi_session_id", "pi_session_file"]) {
    console.log("  " + k + ": " + (s[k] ?? "null"));
  }
}

function cmdEdit(args) {
  const id = args[0];
  if (!id) fail("edit 需要 <id>", 2);
  const text = args.slice(1).join(" ");
  try {
    const t = todos.updateTodo(file(), id, text);
    console.log(t.id + "  " + t.text);
  } catch (e) {
    fail(e.message, /empty/.test(e.message) ? 2 : 1);
  }
}

function cmdStatus(args, status) {
  const id = args[0];
  if (!id) fail(status + " 需要 <id>", 2);
  try {
    const t = todos.setStatus(file(), id, status);
    console.log(t.id + "  " + t.status + "  " + t.text);
  } catch (e) {
    fail(e.message);
  }
}

function cmdRm(args) {
  const id = args[0];
  if (!id) fail("rm 需要 <id>", 2);
  try {
    const t = todos.removeTodo(file(), id);
    console.log(t.id + "  removed  " + t.text);
  } catch (e) {
    fail(e.message);
  }
}

const cmd = process.argv[2];
const args = process.argv.slice(3);
try {
  switch (cmd) {
    case "add": return cmdAdd(args);
    case "list": return cmdList(args);
    case "show": return cmdShow(args);
    case "done": return cmdStatus(args, "done");
    case "edit": return cmdEdit(args);
    case "undo": return cmdStatus(args, "open");
    case "rm": return cmdRm(args);
    case "open": return require("../src/open.js").cmdOpen(args, { fail });
    case "path": console.log(file()); return;
    case undefined:
    case "-h":
    case "--help": process.stdout.write(usage); return;
    default: fail("未知命令 '" + cmd + "'\n\n" + usage, 2);
  }
} catch (e) {
  fail(e.message);
}
